# Copy to .env; never commit actual secrets. Generate four distinct passwords.
# Passwords: at least 32 random hex characters. Do not use literal placeholders.
APP_URL=https://closet.example.com
CADDY_NETWORK=caddy_shared
POSTGRES_DB=closet
POSTGRES_PASSWORD=
DB_APP_PASSWORD=
MINIO_ROOT_PASSWORD=
MINIO_APP_PASSWORD=

# Pin approved image digests before staging/production.
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest

# Optional vision analysis. Keep the real key only in the server environment.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# Only for running Next.js outside Compose against an isolated local DB:
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=closet
# PGUSER=closet_app
# PGPASSWORD=<same value as DB_APP_PASSWORD>
